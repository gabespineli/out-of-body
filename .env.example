# Server-only settings for a NEW dedicated Supabase project.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted, but new projects should use a secret key.
# At least 32 random characters. Enter on the installation once; never put in a QR.
OOB_INSTALLATION_KEY=
# At least 32 random characters; also configure this in Supabase Vault for cleanup.
OOB_CLEANUP_SECRET=
# Stable production HTTPS origin for the printed QR (no path/query; keep this hostname).
# Local development can leave this unset.
OOB_PUBLIC_URL=
